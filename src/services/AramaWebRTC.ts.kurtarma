import {
  RTCPeerConnection,
  RTCSessionDescription,
  RTCIceCandidate,
  mediaDevices,
  MediaStream,
} from "react-native-webrtc";
// src/app/home.tsx
import { API_BASE_URL, WEBSOCKET_URL } from "../config/api";
import AsyncStorage from "@react-native-async-storage/async-storage";
import InCallManager from "react-native-incall-manager";
import { Client, IMessage, StompSubscription } from "@stomp/stompjs";
import { Hoparlor } from "./Hoparlor";

const SUNUCU_ADRESI = API_BASE_URL;

const WEBSOCKET_ADRESI = WEBSOCKET_URL;

const WEBSOCKET_BAGLANTI_TIMEOUT_MS = 15000;

export type AramaTuru = "SES" | "VIDEO";

export type AramaMesaji =
  | {
      tip: "CALL_OFFER";
      arayanId: number;
      arananId: number;
      aramaTuru: AramaTuru;
      teklif: RTCSessionDescriptionInit;
    }
  | {
      tip: "CALL_ANSWER";
      arayanId: number;
      arananId: number;
      cevap: RTCSessionDescriptionInit;
    }
  | {
      tip: "CALL_ICE";
      arayanId: number;
      arananId: number;
      aday: RTCIceCandidateInit;
    }
  | {
      tip: "CALL_REJECT";
      arayanId: number;
      arananId: number;
    }
  | {
      tip: "CALL_END";
      arayanId: number;
      arananId: number;
    };

type AramaOlaylari = {
  teklif: (
    mesaj: AramaMesaji & {
      tip: "CALL_OFFER";
    },
  ) => void;

  cevap: (
    mesaj: AramaMesaji & {
      tip: "CALL_ANSWER";
    },
  ) => void;

  ice: (
    mesaj: AramaMesaji & {
      tip: "CALL_ICE";
    },
  ) => void;

  reddet: (
    mesaj: AramaMesaji & {
      tip: "CALL_REJECT";
    },
  ) => void;

  bitir: (
    mesaj: AramaMesaji & {
      tip: "CALL_END";
    },
  ) => void;

  baglandi: () => void;

  uzakStream: (stream: MediaStream) => void;

  baglantiKoptu: () => void;

  hata: (hata: Error) => void;
};

type BackendAramaSinyali = {
  hedefKullaniciId: number;
  tur: string;
  tip: string;
  sdp?: string | null;
  aday?: string | null;
  sdpMid?: string | null;
  sdpMLineIndex?: number | null;
};

class AramaWebRTC {
  private peerConnection: RTCPeerConnection | null = null;

  private yerelStream: MediaStream | null = null;

  private uzakStream: MediaStream | null = null;

  private mevcutKullaniciId: number | null = null;

  private arananKullaniciId: number | null = null;

  private aramaTuru: AramaTuru = "SES";

  /**
   * =========================================================
   * STOMP CLIENT
   * =========================================================
   */

  private stompClient: Client | null = null;

  private webSocketBagli = false;

  private webSocketBaglantiPromise: Promise<void> | null = null;

  private aramaSubscription: StompSubscription | null = null;

  private hariciSinyalGonderici:
    | ((sinyal: BackendAramaSinyali) => void | Promise<void>)
    | null = null;

  /**
   * =========================================================
   * ICE
   * =========================================================
   */

  private bekleyenIceAdaylari: RTCIceCandidateInit[] = [];

  private remoteDescriptionHazir = false;

  private aramaSonlandiriliyor = false;
  private webRtcBaglandiBildirildi = false;

  // Ayni anda iki createOffer �alı�Ymasini engeller.
  // �-zellikle medya alma ile arama ba�Ylatmanin yarı�Ymasi halinde
  // SDP m-line sirasinin bozulmasini �nler.
  private offerOlusturuluyor = false;

  // Ayni arama i�in aramaBaslat() birden fazla kez tetiklenirse
  // ikinci �a�Yri yeni bir createOffer ba�Ylatmaz; ilk �a�Yrinin
  // Promise'ini bekler. B�ylece ayni PeerConnection kapanmadan
  // ikinci offer �retme yarı�Yi olu�Ymaz.
  private aramaBaslatPromise: Promise<RTCSessionDescriptionInit> | null = null;

  /**
   * =========================================================
   * ARAMA SESI / ANDROID CALL AUDIO
   * =========================================================
   */

  private aramaSesiCaliyor = false;
  private aramaAudioOturumuAcik = false;
  private hoparlorAcik = false;

  private aramaSesiniBaslat() {
    try {
      if (this.aramaSesiCaliyor) {
        console.log("?? Arama ringback sesi zaten �alı�Yiyor.");
        return;
      }

      // GIDEN ARAMA: kar�Yi taraf cevap verene kadar ringback �al.
      // Incoming arama i�in startRingtone(), outgoing arama i�in
      // startRingback() kullanilmalidir.
      InCallManager.startRingback("_DEFAULT_");

      this.aramaSesiCaliyor = true;

      console.log("gY""gY"� GIDEN ARAMA RINGBACK BASLATILDI (_DEFAULT_)");
    } catch (hata) {
      this.aramaSesiCaliyor = false;
      console.warn("�s�️ Giden arama ringback ba�Ylatilamadi:", hata);
    }
  }

  private gelenAramaSesiniBaslat() {
    try {
      if (this.aramaSesiCaliyor) {
        console.log("?? Gelen arama ringtone zaten �alı�Yiyor.");
        return;
      }

      // GELEN ARAMA: kullanici cevaplayana/reddedene kadar telefon zili.
      InCallManager.startRingtone("_DEFAULT_");

      this.aramaSesiCaliyor = true;

      console.log("gY""gY"� GELEN ARAMA RINGTONE BASLATILDI");
    } catch (hata) {
      this.aramaSesiCaliyor = false;
      console.warn("�s�️ Gelen arama ringtone ba�Ylatilamadi:", hata);
    }
  }

  private aramaSesiniDurdur() {
    try {
      if (!this.aramaSesiCaliyor) {
        return;
      }

      try {
        InCallManager.stopRingback();
      } catch (hata) {
        console.warn("�s�️ Ringback durdurulamadi:", hata);
      }

      try {
        InCallManager.stopRingtone();
      } catch (hata) {
        console.warn("�s�️ Ringtone durdurulamadi:", hata);
      }

      this.aramaSesiCaliyor = false;

      console.log("gY".gY"� ARAMA ZIL SESI DURDURULDU");
    } catch (hata) {
      this.aramaSesiCaliyor = false;
      console.warn("�s�️ Arama zil sesi durdurulamadi:", hata);
    }
  }

  private aramaSesiniTemizle() {
    try {
      try {
        InCallManager.stopRingback();
      } catch {}

      try {
        InCallManager.stopRingtone();
      } catch {}
    } finally {
      this.aramaSesiCaliyor = false;
    }
  }

  private aramaAudioOturumunuBaslat(): boolean {
    try {
      if (this.aramaAudioOturumuAcik) {
        console.log("?? CALL AUDIO OTURUMU ZATEN A�?IK");
        return true;
      }

      const medya = this.aramaTuru === "VIDEO" ? "video" : "audio";

      console.log("======================================");
      console.log("gY�� CALL AUDIO OTURUMU BASLATILIYOR");
      console.log("gY�� Medya:", medya);
      console.log("======================================");

      const baslatildi = Hoparlor.aramayiBaslat(medya);

      if (!baslatildi) {
        console.warn("�s�️ CALL AUDIO OTURUMU BASLATILAMADI.");

        this.aramaAudioOturumuAcik = false;
        this.hoparlorAcik = false;

        return false;
      }

      // G�r�nt�l� aramada hoparl�r varsayilan olarak A�?IK,
      // sesli aramada ahize varsayilan olarak A�?IK olsun.
      this.hoparlorAcik = this.aramaTuru === "VIDEO";
      this.aramaAudioOturumuAcik = true;

      console.log("======================================");
      console.log("gY��gY"� CALL AUDIO OTURUMU BASLATILDI");
      console.log(
        this.hoparlorAcik ? "gY"S VIDEO: HOPARL�-R A�?IK" : "gY"^ SES: AHIZE A�?IK",
      );
      console.log("======================================");

      return true;
    } catch (hata) {
      this.aramaAudioOturumuAcik = false;
      this.hoparlorAcik = false;

      console.warn("�s�️ CALL AUDIO OTURUMU BASLATILAMADI:", hata);

      return false;
    }
  }

  private aramaAudioOturumunuKapat() {
    try {
      if (!this.aramaAudioOturumuAcik) {
        return;
      }

      Hoparlor.aramayiBitir();

      this.aramaAudioOturumuAcik = false;
      this.hoparlorAcik = false;

      console.log("gY��gY"� CALL AUDIO OTURUMU KAPATILDI");
    } catch (hata) {
      this.aramaAudioOturumuAcik = false;
      console.warn("�s�️ Call audio oturumu kapatilamadi:", hata);
    }
  }

