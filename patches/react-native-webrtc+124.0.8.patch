+    private void attachE2EESenderIfReady(int pcId, RtpSender sender) {
+        E2EESession session = mE2EESessions.get(pcId);
+        if (session == null || !mE2EEInitialized.get(pcId, false)
+                || !mE2EEPeerConfirmed.get(pcId, false)
+                || sender == null) {
+            return;
+        }
+        sender.setFrameEncryptor(session);
+        if (!sender.hasFrameEncryptor()) {
+            throw new IllegalStateException("E2EE sender encryptor bağlanamadı");
+        }
+    }
+
+    private void closeE2EESessionInternal(int pcId) {
+        E2EESession session = mE2EESessions.get(pcId);
+        if (session == null) {
+            mE2EEInitialized.remove(pcId);
+            mE2EEConfirmationCreated.remove(pcId);
+            mE2EEPeerConfirmed.remove(pcId);
+
+            // E2EE zorunlu bağlantıda oturum kayıpsa bağlantı açık bırakılamaz.
+            if (mE2EERequired.get(pcId, false)) {
+                PeerConnectionObserver observer = mPeerConnectionObservers.get(pcId);
+                PeerConnection pc = observer == null ? null : observer.getPeerConnection();
+
+                if (pc != null) {
+                    try {
+                        Log.e(TAG, "E2EE oturumu bulunamadı; PeerConnection fail-closed kapatılıyor");
+                        pc.close();
+                    } catch (Exception e) {
+                        Log.e(TAG, "E2EE oturum kaybında PeerConnection kapatılamadı", e);
+                    }
+                }
+            }
+            return;
+        }
+
+        try {
+            PeerConnectionObserver observer = mPeerConnectionObservers.get(pcId);
+            PeerConnection pc = observer == null ? null : observer.getPeerConnection();
+
+            if (pc != null) {
+                boolean senderShutdownFailed = false;
+
+                // Önce track'leri kaldır. Herhangi biri başarısızsa encryptor'lara
+                // dokunmadan PeerConnection'ı kapat.
+                for (RtpSender sender : pc.getSenders()) {
+                    try {
+                        if (sender.track() != null && !sender.setTrack(null, false)) {
+                            senderShutdownFailed = true;
+                            Log.e(TAG, "E2EE sender track kaldırılamadı; bağlantı kapatılacak");
+                            break;
+                        }
+                    } catch (Exception e) {
+                        senderShutdownFailed = true;
+                        Log.e(TAG, "E2EE sender track kaldırma hatası; bağlantı kapatılacak", e);
+                        break;
+                    }
+                }
+
+                if (senderShutdownFailed) {
+                    try {
+                        pc.close();
+                    } catch (Exception e) {
+                        Log.e(TAG, "E2EE güvenlik kapatması başarısız", e);
+                    }
+                }
+
+                // Track'ler kaldırıldıktan veya bağlantı kapatıldıktan sonra encryptor'ları ayır.
+                for (RtpSender sender : pc.getSenders()) {
+                    try {
+                        sender.setFrameEncryptor(null);
+                    } catch (Exception e) {
+                        Log.e(TAG, "E2EE encryptor ayrılamadı; bağlantı kapatılıyor", e);
+                        try {
+                            pc.close();
+                        } catch (Exception closeError) {
+                            Log.e(TAG, "PeerConnection kapatma hatası", closeError);
+                        }
+                    }
+                }
+
+                for (RtpReceiver receiver : pc.getReceivers()) {
+                    try {
+                        receiver.setFrameDecryptor(null);
+                    } catch (Exception e) {
+                        Log.e(TAG, "E2EE receiver decryptor ayrılamadı; bağlantı kapatılıyor", e);
+                        try {
+                            pc.close();
+                        } catch (Exception closeError) {
+                            Log.e(TAG, "Receiver güvenlik kapatması başarısız", closeError);
+                        }
+                    }
+                }
+            }
+        } finally {
+            mE2EESessions.remove(pcId);
+            mE2EEInitialized.remove(pcId);
+            mE2EEConfirmationCreated.remove(pcId);
+            mE2EEPeerConfirmed.remove(pcId);
+            session.close();
+        }
+    }
