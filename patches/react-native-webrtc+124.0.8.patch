+    @ReactMethod
+    public void e2eeInitializeSession(
+            int pcId,
+            String peerPublicKeyBase64,
+            String saltBase64,
+            String transcriptHashBase64,
+            boolean isInitiator,
+            Promise promise) {
+
+        ThreadUtils.runOnExecutor(() -> {
+            byte[] peerPublicKey = null;
+            byte[] salt = null;
+            byte[] transcriptHash = null;
+
+            try {
+                E2EESession session = mE2EESessions.get(pcId);
+                PeerConnectionObserver observer = mPeerConnectionObservers.get(pcId);
+
+                if (session == null || observer == null
+                        || observer.getPeerConnection() == null) {
+                    promise.reject("E2EE_SESSION_MISSING", "E2EE oturumu veya bağlantı bulunamadı");
+                    return;
+                }
+
+                if (mE2EEInitialized.get(pcId, false)) {
+                    promise.reject("E2EE_ALREADY_INITIALIZED", "E2EE oturumu zaten başlatılmış");
+                    return;
+                }
+
+                peerPublicKey = Base64.decode(peerPublicKeyBase64, Base64.DEFAULT);
+                salt = Base64.decode(saltBase64, Base64.DEFAULT);
+                transcriptHash = Base64.decode(transcriptHashBase64, Base64.DEFAULT);
+
+                if (peerPublicKey.length != 32 || salt.length != 32
+                        || transcriptHash.length != 32) {
+                    promise.reject("E2EE_INVALID_KEY_MATERIAL", "Anahtar malzemeleri 32 byte olmalı");
+                    return;
+                }
+
+                // IMPORTANT:
+                // The application must authenticate the peer key before calling this method.
+                if (!session.initialize(peerPublicKey, salt, transcriptHash, isInitiator)) {
+                    promise.reject("E2EE_INITIALIZATION_FAILED", "Native E2EE başlatılamadı");
+                    return;
+                }
+
+                PeerConnection pc = observer.getPeerConnection();
+
+                // Anahtarlar hazır; gönderim peer key confirmation tamamlanana
+                // kadar kapalı kalır. Alıcı decryptor'ları önceden bağlanır.
+                mE2EEInitialized.put(pcId, true);
+                mE2EEConfirmationCreated.put(pcId, false);
+                mE2EEPeerConfirmed.put(pcId, false);
+
+                for (RtpReceiver receiver : pc.getReceivers()) {
+                    attachE2EEReceiverIfReady(pcId, receiver);
+                }
+
+                promise.resolve(true);
+
+            } catch (Exception e) {
+                closeE2EESessionInternal(pcId);
+                promise.reject("E2EE_INITIALIZATION_FAILED", e);
+            } finally {
+                if (peerPublicKey != null) java.util.Arrays.fill(peerPublicKey, (byte) 0);
+                if (salt != null) java.util.Arrays.fill(salt, (byte) 0);
+                if (transcriptHash != null) java.util.Arrays.fill(transcriptHash, (byte) 0);
+            }
+        });
+    }
+
+    @ReactMethod
+    public void e2eeCreateKeyConfirmation(int pcId, Promise promise) {
+        ThreadUtils.runOnExecutor(() -> {
+            byte[] confirmation = null;
+            try {
+                E2EESession session = mE2EESessions.get(pcId);
+                if (session == null || !mE2EEInitialized.get(pcId, false)) {
+                    promise.reject("E2EE_NOT_INITIALIZED", "E2EE anahtarları hazır değil");
+                    return;
+                }
+                if (mE2EEConfirmationCreated.get(pcId, false)
+                        || mE2EEPeerConfirmed.get(pcId, false)) {
+                    promise.reject("E2EE_CONFIRMATION_ALREADY_CREATED",
+                            "Anahtar onayı daha önce oluşturulmuş");
+                    return;
+                }
+
+                confirmation = session.createKeyConfirmation();
+                if (confirmation == null || confirmation.length != 32) {
+                    throw new IllegalStateException("Geçersiz key confirmation uzunluğu");
+                }
+
+                String encoded = Base64.encodeToString(confirmation, Base64.NO_WRAP);
+                mE2EEConfirmationCreated.put(pcId, true);
+                promise.resolve(encoded);
+            } catch (Exception e) {
+                closeE2EESessionInternal(pcId);
+                promise.reject("E2EE_CONFIRMATION_CREATE_FAILED", e);
+            } finally {
+                if (confirmation != null) {
+                    java.util.Arrays.fill(confirmation, (byte) 0);
+                }
+            }
+        });
+    }
+
+    @ReactMethod
+    public void e2eeVerifyPeerKeyConfirmation(
+            int pcId, String confirmationBase64, Promise promise) {
+        ThreadUtils.runOnExecutor(() -> {
+            byte[] confirmation = null;
+            try {
+                E2EESession session = mE2EESessions.get(pcId);
+                PeerConnectionObserver observer = mPeerConnectionObservers.get(pcId);
+
+                if (session == null || observer == null
+                        || observer.getPeerConnection() == null
+                        || !mE2EEInitialized.get(pcId, false)) {
+                    promise.reject("E2EE_SESSION_MISSING", "E2EE oturumu hazır değil");
+                    return;
+                }
+                if (!mE2EEConfirmationCreated.get(pcId, false)
+                        || mE2EEPeerConfirmed.get(pcId, false)) {
+                    promise.reject("E2EE_CONFIRMATION_STATE_INVALID",
+                            "Yerel key confirmation oluşturulmamış veya oturum zaten onaylanmış");
+                    return;
+                }
+
+                confirmation = Base64.decode(confirmationBase64, Base64.DEFAULT);
+                if (confirmation.length != 32
+                        || !session.verifyPeerKeyConfirmation(confirmation)) {
+                    closeE2EESessionInternal(pcId);
+                    promise.reject("E2EE_PEER_CONFIRMATION_FAILED",
+                            "Karşı tarafın key confirmation doğrulanamadı");
+                    return;
+                }
+
+                mE2EEPeerConfirmed.put(pcId, true);
+                PeerConnection pc = observer.getPeerConnection();
+
+                for (RtpSender sender : pc.getSenders()) {
+                    attachE2EESenderIfReady(pcId, sender);
+                    if (sender.track() != null && !sender.hasFrameEncryptor()) {
+                        throw new IllegalStateException(
+                                "Medya göndericisine E2EE encryptor bağlanamadı");
+                    }
+                }
+
+                // Peer key confirmation başarılı.
+                // Mevcut alıcıların decryptor bağlantılarını şimdi kur.
+                for (RtpReceiver receiver : pc.getReceivers()) {
+                    attachE2EEReceiverIfReady(pcId, receiver);
+                }
+
+                promise.resolve(true);
+            } catch (Exception e) {
+                closeE2EESessionInternal(pcId);
+                promise.reject("E2EE_PEER_CONFIRMATION_FAILED", e);
+            } finally {
+                if (confirmation != null) {
+                    java.util.Arrays.fill(confirmation, (byte) 0);
+                }
+            }
+        });
+    }
+
+    @ReactMethod
