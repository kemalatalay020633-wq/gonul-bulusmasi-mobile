+    @ReactMethod
+    public void e2eeCreateSession(int pcId, Promise promise) {
+        ThreadUtils.runOnExecutor(() -> {
+            try {
+                PeerConnectionObserver observer = mPeerConnectionObservers.get(pcId);
+                if (observer == null || observer.getPeerConnection() == null) {
+                    promise.reject("E2EE_PC_MISSING", "PeerConnection bulunamadı");
+                    return;
+                }
+
+                if (mE2EESessions.get(pcId) != null) {
+                    promise.reject("E2EE_SESSION_EXISTS", "E2EE oturumu zaten mevcut");
+                    return;
+                }
+
+                E2EESession session = new E2EESession();
+                try {
+                    byte[] publicKey = session.getPublicKey();
+                    mE2EESessions.put(pcId, session);
+                    promise.resolve(Base64.encodeToString(publicKey, Base64.NO_WRAP));
+                } catch (Exception e) {
+                    session.close();
+                    throw e;
+                }
+            } catch (Exception e) {
+                promise.reject("E2EE_CREATE_FAILED", e);
+            }
+        });
+    }
